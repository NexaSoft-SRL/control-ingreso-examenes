# Copiar a .env y completar. El .env NUNCA se sube al repositorio.
APP_NAME="Control de ingreso a examenes masivos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/La_Paz
APP_URL=http://localhost:8000
APP_LOCALE=es

# Base de datos.
# En desarrollo: PostgreSQL 15 (mismo motor que el servidor de TIS).
# Si TIS confirma que el hosting solo admite MySQL, cambiar a mysql/3306.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=control_ingreso
DB_USERNAME=nexasoft
DB_PASSWORD=nexasoft

# En el servidor de TIS estos tres valores los entrega la administracion
# junto con el dominio del proyecto.

SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=database
LOG_CHANNEL=stack
LOG_LEVEL=debug
