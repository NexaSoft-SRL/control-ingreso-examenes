includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: max

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - scripts/architecture
        - tests
        - deptrac.php
        - deptrac.modules.php

    tmpDir: storage/framework/cache/phpstan
