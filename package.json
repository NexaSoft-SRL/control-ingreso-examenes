{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "lint": "eslint resources/js",
        "lint:fix": "eslint resources/js --fix",
        "format": "prettier --write resources/js resources/css vitest.config.js",
        "format:check": "prettier --check resources/js resources/css vitest.config.js",
        "quality": "npm run lint && npm run format:check && npm run test:run && npm run build",
        "test": "vitest",
        "test:run": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@vitejs/plugin-react": "^5.2.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    }
}
